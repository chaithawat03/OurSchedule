# Browser configuration is not secret, but always select the intended environment.
# For Staging, use Firebase Web app config from 'firebase apps:sdkconfig WEB --project ourschedule'.
# Keep .env.local ignored; NEVER point a staging deploy at a Production project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional App Check rollout (STAGING only). Set only after Firebase App Check + reCAPTCHA v3 are registered.
# Site key is public; DO NOT add the reCAPTCHA secret key to Vite or Git.
# VITE_RECAPTCHA_V3_SITE_KEY=
