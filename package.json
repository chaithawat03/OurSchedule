{
  "name": "ourschedule",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src",
    "test:unit": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-ourschedule-ci \"node --test tests/security/*.test.mjs\"",
    "test": "npm run test:unit && npm run test:rules"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.0",
    "firebase-tools": "^15.34.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.4",
    "firebase": "^13.0.0"
  },
  "engines": {
    "node": ">=24.12.0 <25"
  }
}
