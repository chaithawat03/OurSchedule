rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwnUser(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validProfile(data) {
      return data.keys().hasAll(['displayName', 'avatar', 'locale', 'timezone', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['displayName', 'avatar', 'locale', 'timezone', 'createdAt', 'updatedAt'])
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 80
        && data.avatar is string && data.avatar.size() <= 2048
        && data.locale == 'th-TH'
        && data.timezone == 'Asia/Bangkok'
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    match /users/{uid} {
      allow get: if isOwnUser(uid);
      allow list: if false;
      allow create: if isOwnUser(uid)
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwnUser(uid)
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['displayName', 'avatar', 'locale', 'timezone', 'updatedAt']);
      allow delete: if false;
      match /{nested=**} {
        allow read, write: if false;
      }
    }


    function signedIn() {
      return request.auth != null;
    }

    function isRoomOwner(ownerUid) {
      return signedIn() && ownerUid == request.auth.uid;
    }


    // Per-UID spend counters are validated in Firestore Rules, not merely the UI.
    // One new resource must consume exactly one counter transition in the SAME
    // atomic transaction. lastResourceId prevents multi-create reuse of a batch.
    function quotaPath(uid, kind) {
      return /databases/$(database)/documents/users/$(uid)/quotas/$(kind);
    }

    function quotaValid(data) {
      return data.keys().hasAll(['count', 'windowStart', 'updatedAt', 'lastResourceId'])
        && data.keys().hasOnly(['count', 'windowStart', 'updatedAt', 'lastResourceId'])
        && data.count is int && data.count >= 1 && data.count <= 20
        && data.windowStart is timestamp && data.updatedAt is timestamp
        && data.lastResourceId is string && data.lastResourceId.size() > 0
        && data.lastResourceId.size() <= 120;
    }

    function quotaProgress(before, after, maximum) {
      return before.windowStart <= request.time - duration.value(1, 'd')
        ? (after.count == 1 && after.windowStart == request.time)
        : (before.count < maximum && after.count == before.count + 1
           && after.windowStart == before.windowStart);
    }

    function quotaConsumed(uid, kind, resourceId, maximum) {
      let path = quotaPath(uid, kind);
      let after = getAfter(path).data;
      return signedIn() && request.auth.uid == uid
        && quotaValid(after) && after.lastResourceId == resourceId
        && after.updatedAt == request.time && after.count <= maximum
        && (!exists(path)
          ? (after.count == 1 && after.windowStart == request.time)
          : quotaProgress(get(path).data, after, maximum));
    }

    // The counter may be incremented without creating the resource (self-DoS),
    // but no resource can be created without a *fresh* matching counter step.
    match /users/{uid}/quotas/{kind} {
      allow get: if isOwnUser(uid) && kind in ['rooms', 'invites', 'personalEvents', 'roomEvents'];
      allow list: if false;
      allow create: if isOwnUser(uid) && kind in ['rooms', 'invites', 'personalEvents', 'roomEvents']
        && quotaValid(request.resource.data)
        && request.resource.data.count == 1
        && request.resource.data.windowStart == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwnUser(uid) && kind in ['rooms', 'invites', 'personalEvents', 'roomEvents']
        && quotaValid(resource.data) && quotaValid(request.resource.data)
        && request.resource.data.updatedAt == request.time
        && quotaProgress(resource.data, request.resource.data,
             kind == 'rooms' ? 3 : (kind == 'invites' ? 10 : 20));
      allow delete: if false;
    }

    function validInviteToken(token) {
      return token is string && token.matches('^[A-Za-z0-9_-]{43}$');
    }

    function activeMembership(roomId, uid) {
      return signedIn()
        && exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(uid))
        && get(/databases/$(database)/documents/rooms/$(roomId)/members/$(uid)).data.uid == uid
        && get(/databases/$(database)/documents/rooms/$(roomId)/members/$(uid)).data.membershipState == 'active';
    }

    function joinedMemberValid(data, uid) {
      return data.keys().hasAll(['uid', 'role', 'membershipState', 'joinedAt', 'inviteId'])
        && data.keys().hasOnly(['uid', 'role', 'membershipState', 'joinedAt', 'inviteId'])
        && data.uid == uid && data.role == 'member'
        && data.membershipState == 'active'
        && data.joinedAt is timestamp && data.joinedAt == request.time
        && validInviteToken(data.inviteId);
    }

    function inviteShapeValid(data) {
      return data.keys().hasAll(['roomId', 'createdByUid', 'createdAt', 'expiresAt',
                                 'state', 'acceptedByUid', 'acceptedAt'])
        && data.keys().hasOnly(['roomId', 'createdByUid', 'createdAt', 'expiresAt',
                                 'state', 'acceptedByUid', 'acceptedAt'])
        && data.roomId is string && data.roomId.size() > 0 && data.roomId.size() <= 120
        && data.createdByUid is string && data.createdByUid.size() > 0
        && data.createdAt is timestamp && data.expiresAt is timestamp
        && data.state in ['pending', 'accepted', 'revoked']
        && (data.acceptedByUid == null || data.acceptedByUid is string)
        && (data.acceptedAt == null || data.acceptedAt is timestamp);
    }

    function validInviteAcceptance(inviteId) {
      return request.resource.data.state == 'accepted'
        && request.resource.data.acceptedByUid == request.auth.uid
        && request.resource.data.acceptedAt == request.time
        && exists(/databases/$(database)/documents/rooms/$(resource.data.roomId))
        && get(/databases/$(database)/documents/rooms/$(resource.data.roomId)).data.ownerUid != request.auth.uid
        && !exists(/databases/$(database)/documents/rooms/$(resource.data.roomId)/members/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/rooms/$(resource.data.roomId)/members/$(request.auth.uid)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/rooms/$(resource.data.roomId)/members/$(request.auth.uid)).data.role == 'member'
        && getAfter(/databases/$(database)/documents/rooms/$(resource.data.roomId)/members/$(request.auth.uid)).data.membershipState == 'active'
        && getAfter(/databases/$(database)/documents/rooms/$(resource.data.roomId)/members/$(request.auth.uid)).data.inviteId == inviteId;
    }

    function validJoinFromInvite(roomId, uid, inviteId) {
      return exists(/databases/$(database)/documents/roomInvites/$(inviteId))
        && get(/databases/$(database)/documents/roomInvites/$(inviteId)).data.state == 'pending'
        && get(/databases/$(database)/documents/roomInvites/$(inviteId)).data.expiresAt > request.time
        && getAfter(/databases/$(database)/documents/roomInvites/$(inviteId)).data.state == 'accepted'
        && getAfter(/databases/$(database)/documents/roomInvites/$(inviteId)).data.acceptedByUid == uid
        && getAfter(/databases/$(database)/documents/roomInvites/$(inviteId)).data.acceptedAt == request.time
        && getAfter(/databases/$(database)/documents/roomInvites/$(inviteId)).data.roomId == roomId;
    }

    function roomFieldsValid(data) {
      return data.keys().hasAll(['ownerUid', 'name', 'assignmentPolicy', 'defaultVisibility', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'name', 'assignmentPolicy', 'defaultVisibility', 'createdAt', 'updatedAt'])
        && data.ownerUid is string && data.ownerUid.size() > 0
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 180
        && data.assignmentPolicy in ['AUTO_ASSIGN', 'REQUIRE_ACCEPTANCE']
        && data.defaultVisibility in ['ROOM', 'BUSY_ONLY', 'PRIVATE']
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function ownerMembershipValid(data, uid) {
      return data.keys().hasAll(['uid', 'role', 'membershipState', 'joinedAt'])
        && data.keys().hasOnly(['uid', 'role', 'membershipState', 'joinedAt'])
        && data.uid == uid && data.role == 'owner'
        && data.membershipState == 'active'
        && data.joinedAt is timestamp && data.joinedAt == request.time;
    }

    match /rooms/{roomId} {
      // Query constraint is mandatory: where('ownerUid','==',auth.uid).limit(20).
      // Rules are not filters; no access is granted to rooms owned by other UIDs.
      allow get: if isRoomOwner(resource.data.ownerUid)
        || activeMembership(roomId, request.auth.uid);
      allow list: if isRoomOwner(resource.data.ownerUid)
        && request.query.limit != null && request.query.limit <= 20;
      allow create: if signedIn()
        && roomFieldsValid(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && quotaConsumed(request.auth.uid, 'rooms', roomId, 3)
        && ownerMembershipValid(
          getAfter(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)).data,
          request.auth.uid);
      allow update: if isRoomOwner(resource.data.ownerUid)
        && roomFieldsValid(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'assignmentPolicy', 'defaultVisibility', 'updatedAt']);
      allow delete: if false;

      match /members/{memberUid} {
        // The only membership creation permitted in this phase is the immutable
        // initial owner, atomically alongside a brand-new parent room.
        // Owner may inspect a bounded roster. Member may get own doc only.
        allow get: if signedIn()
          && exists(/databases/$(database)/documents/rooms/$(roomId))
          && (get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerUid == request.auth.uid
              || (memberUid == request.auth.uid && resource.data.membershipState == 'active'));
        allow list: if signedIn()
          && exists(/databases/$(database)/documents/rooms/$(roomId))
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerUid == request.auth.uid
          && request.query.limit != null && request.query.limit <= 20;
        allow create: if signedIn()
          && memberUid == request.auth.uid
          && (
            (!exists(/databases/$(database)/documents/rooms/$(roomId))
             && ownerMembershipValid(request.resource.data, memberUid)
             && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.ownerUid == memberUid)
            ||
            (exists(/databases/$(database)/documents/rooms/$(roomId))
             && joinedMemberValid(request.resource.data, memberUid)
             && validJoinFromInvite(roomId, memberUid, request.resource.data.inviteId))
          );
        allow update: if false;
        // No owner deletion or role escalation. Any Member can leave,
        // or the Room Owner may revoke that member's access.
        allow delete: if signedIn() && resource.data.role == 'member'
          && exists(/databases/$(database)/documents/rooms/$(roomId))
          && (memberUid == request.auth.uid
              || get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerUid == request.auth.uid);
      }
      match /{nested=**} {
        allow read, write: if false;
      }
    }

    // Collection group query for the authenticated UID's memberships.
    // Must be filtered by uid == auth.uid and limited to 20. This read
    // exposes only the caller's own membership, not other members.
    // The write rules in /rooms/{roomId}/members remain unchanged.
    match /{path=**}/members/{memberId} {
      allow list: if signedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.role == 'member'
        && resource.data.membershipState == 'active'
        && request.query.limit != null && request.query.limit <= 20;
    }

    // Possession of a 256-bit bearer token grants only a narrow invitation lookup.
    // Membership must be created in the SAME atomic batch as invite redemption.
    match /roomInvites/{inviteId} {
      allow get: if signedIn() && validInviteToken(inviteId);
      allow list: if false;
      allow create: if signedIn()
        && validInviteToken(inviteId)
        && inviteShapeValid(request.resource.data)
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.state == 'pending'
        && request.resource.data.acceptedByUid == null
        && request.resource.data.acceptedAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(2, 'd')
        && quotaConsumed(request.auth.uid, 'invites', inviteId, 10)
        && exists(/databases/$(database)/documents/rooms/$(request.resource.data.roomId))
        && get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && validInviteToken(inviteId)
        && inviteShapeValid(request.resource.data)
        && resource.data.state == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['state', 'acceptedByUid', 'acceptedAt'])
        && (
          (resource.data.createdByUid == request.auth.uid
            && request.resource.data.state == 'revoked'
            && request.resource.data.acceptedByUid == null
            && request.resource.data.acceptedAt == null)
          ||
          (resource.data.expiresAt > request.time
            && validInviteAcceptance(inviteId))
        );
      allow delete: if false;
    }


    // M3.1 private personal events; room owners and admins have NO grant here.
    function personalFieldsValid(data, uid) {
      return data.keys().hasAll(['ownerUid','creatorUid','title','notes','startAt',
          'endAt','allDay','timezone','visibility','status','createdAt','updatedAt'])
        && data.keys().hasOnly(['ownerUid','creatorUid','title','notes','startAt',
          'endAt','allDay','timezone','visibility','status','createdAt','updatedAt'])
        && data.ownerUid == uid && data.creatorUid == uid
        && data.title is string && data.title.size() > 0 && data.title.size() <= 360
        && data.notes is string && data.notes.size() <= 2000
        && data.startAt is timestamp && data.endAt is timestamp
        && data.endAt > data.startAt
        && data.endAt <= data.startAt + duration.value(1, 'd')
        && data.allDay is bool && data.timezone == 'Asia/Bangkok'
        && data.visibility == 'PRIVATE' && data.status in ['active','cancelled']
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    match /users/{uid}/personalEvents/{eventId} {
      allow get: if isOwnUser(uid);
      allow list: if isOwnUser(uid)
        && request.query.limit != null && request.query.limit <= 100;
      allow create: if isOwnUser(uid)
        && personalFieldsValid(request.resource.data, uid)
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && quotaConsumed(uid, 'personalEvents', eventId, 20);
      allow update: if isOwnUser(uid)
        && personalFieldsValid(request.resource.data, uid)
        && resource.data.status == 'active'
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.creatorUid == resource.data.creatorUid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title','notes','startAt','endAt','allDay','updatedAt','status'])
        && (request.resource.data.status == 'active'
          || (request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
              ['status','updatedAt'])));
      allow delete: if false;
      match /{nested=**} { allow read, write: if false; }
    }


    // M3.2a: one direct recipient per room activity. PRIVATE is a strict
    // unshared envelope; a deliberate recipient inbox is not a room-wide feed.
    // ROOM / BUSY_ONLY projections remain DENIED until M3.2b privacy review.
    function roomEventPath(roomId, eventId) {
      return /databases/$(database)/documents/rooms/$(roomId)/events/$(eventId);
    }

    function roomAssignmentPath(uid, eventId) {
      return /databases/$(database)/documents/users/$(uid)/roomActivityInvites/$(eventId);
    }

    function eligibleRecipient(roomId, uid, issuedAt) {
      let memberPath = /databases/$(database)/documents/rooms/$(roomId)/members/$(uid);
      return signedIn() && exists(memberPath)
        && get(memberPath).data.uid == uid
        && get(memberPath).data.role == 'member'
        && get(memberPath).data.membershipState == 'active'
        && get(memberPath).data.joinedAt <= issuedAt;
    }

    function roomEventValid(event, roomId) {
      return event.keys().hasAll([
          'roomId','creatorUid','recipientUid','title','notes',
          'startAt','endAt','allDay','timezone','visibility','status',
          'createdAt','updatedAt'
        ])
        && event.keys().hasOnly([
          'roomId','creatorUid','recipientUid','title','notes',
          'startAt','endAt','allDay','timezone','visibility','status',
          'createdAt','updatedAt'
        ])
        && event.roomId == roomId
        && event.creatorUid is string && event.creatorUid.size() > 0
        && event.recipientUid is string && event.recipientUid.size() > 0
        && event.creatorUid != event.recipientUid
        && event.title is string && event.title.size() > 0 && event.title.size() <= 360
        && event.notes is string && event.notes.size() <= 2000
        && event.startAt is timestamp && event.endAt is timestamp
        && event.endAt > event.startAt
        && event.endAt <= event.startAt + duration.value(1, 'd')
        && event.allDay is bool && event.timezone == 'Asia/Bangkok'
        && event.visibility == 'PRIVATE'
        && event.status in ['active','cancelled']
        && event.createdAt is timestamp && event.updatedAt is timestamp;
    }

    function roomInboxValid(inbox, recipientUid, eventId) {
      return inbox.keys().hasAll([
          'roomId','eventId','creatorUid','recipientUid','title',
          'startAt','endAt','state','createdAt','updatedAt'
        ])
        && inbox.keys().hasOnly([
          'roomId','eventId','creatorUid','recipientUid','title',
          'startAt','endAt','state','createdAt','updatedAt'
        ])
        && inbox.roomId is string && inbox.roomId.size() > 0
        && inbox.eventId == eventId
        && inbox.recipientUid == recipientUid
        && inbox.creatorUid is string && inbox.creatorUid.size() > 0
        && inbox.title is string && inbox.title.size() > 0 && inbox.title.size() <= 360
        && inbox.startAt is timestamp && inbox.endAt is timestamp
        && inbox.endAt > inbox.startAt
        && inbox.state in ['PENDING','ACCEPTED','DECLINED']
        && inbox.createdAt is timestamp && inbox.updatedAt is timestamp;
    }

    function inboxStartsFromSameEvent(inbox, recipientUid, eventId) {
      let event = getAfter(roomEventPath(inbox.roomId, eventId)).data;
      let room = get(/databases/$(database)/documents/rooms/$(inbox.roomId)).data;
      return signedIn() && inbox.creatorUid == request.auth.uid
        && room.ownerUid == request.auth.uid
        && event.creatorUid == request.auth.uid
        && event.recipientUid == recipientUid
        && event.roomId == inbox.roomId
        && event.title == inbox.title
        && event.startAt == inbox.startAt && event.endAt == inbox.endAt
        && event.status == 'active' && event.visibility == 'PRIVATE'
        && event.createdAt == request.time && event.updatedAt == request.time
        && inbox.state == (room.assignmentPolicy == 'AUTO_ASSIGN' ? 'ACCEPTED' : 'PENDING')
        && eligibleRecipient(inbox.roomId, recipientUid, request.time);
    }

    function creatorEventCreation(roomId, eventId, event) {
      let room = get(/databases/$(database)/documents/rooms/$(roomId)).data;
      let inbox = getAfter(roomAssignmentPath(event.recipientUid, eventId)).data;
      return signedIn()
        && room.ownerUid == request.auth.uid
        && event.creatorUid == request.auth.uid
        && eligibleRecipient(roomId, event.recipientUid, request.time)
        && quotaConsumed(request.auth.uid, 'roomEvents', eventId, 20)
        && inbox.roomId == roomId && inbox.eventId == eventId
        && inbox.creatorUid == event.creatorUid
        && inbox.recipientUid == event.recipientUid
        && inbox.title == event.title
        && inbox.startAt == event.startAt && inbox.endAt == event.endAt
        && inbox.createdAt == request.time && inbox.updatedAt == request.time
        && inbox.state == (room.assignmentPolicy == 'AUTO_ASSIGN' ? 'ACCEPTED' : 'PENDING');
    }

    function canReadAssignedRoomEvent(roomId, eventId, event) {
      let inboxPath = roomAssignmentPath(request.auth.uid, eventId);
      return signedIn() && event.recipientUid == request.auth.uid
        && event.status == 'active'
        && exists(inboxPath)
        && get(inboxPath).data.roomId == roomId
        && get(inboxPath).data.creatorUid == event.creatorUid
        && get(inboxPath).data.state == 'ACCEPTED'
        && eligibleRecipient(roomId, request.auth.uid, get(inboxPath).data.createdAt);
    }

    match /rooms/{roomId}/events/{eventId} {
      allow get: if signedIn()
        && ((resource.data.creatorUid == request.auth.uid
             && isRoomOwner(get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerUid))
          || canReadAssignedRoomEvent(roomId, eventId, resource.data));
      allow list: if signedIn()
        && resource.data.creatorUid == request.auth.uid
        && isRoomOwner(get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerUid)
        && request.query.limit != null && request.query.limit <= 20;
      allow create: if signedIn()
        && roomEventValid(request.resource.data, roomId)
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && creatorEventCreation(roomId, eventId, request.resource.data);
      // Status-only cancel; recipient cannot edit event content.
      // Inbox remains history but no accepted participant may read cancelled event.
      allow update: if signedIn()
        && resource.data.creatorUid == request.auth.uid
        && isRoomOwner(get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerUid)
        && roomEventValid(request.resource.data, roomId)
        && resource.data.status == 'active'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status','updatedAt']);
      allow delete: if false;
      match /{nested=**} { allow read, write: if false; }
    }

    // Per-recipient inbox is not a room-visible calendar projection.
    // It is readable to the named recipient alone, or by its creator via
    // direct get to render assignment status (never list other users).
    match /users/{uid}/roomActivityInvites/{eventId} {
      allow get: if isOwnUser(uid)
        || (signedIn() && resource.data.creatorUid == request.auth.uid
          && isRoomOwner(get(/databases/$(database)/documents/rooms/$(resource.data.roomId)).data.ownerUid));
      allow list: if isOwnUser(uid)
        && request.query.limit != null && request.query.limit <= 20;
      allow create: if signedIn()
        && roomInboxValid(request.resource.data, uid, eventId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && inboxStartsFromSameEvent(request.resource.data, uid, eventId);
      allow update: if isOwnUser(uid)
        && roomInboxValid(request.resource.data, uid, eventId)
        && resource.data.state == 'PENDING'
        && request.resource.data.state in ['ACCEPTED','DECLINED']
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state','updatedAt'])
        && exists(roomEventPath(resource.data.roomId, eventId))
        && get(roomEventPath(resource.data.roomId, eventId)).data.status == 'active'
        && get(roomEventPath(resource.data.roomId, eventId)).data.recipientUid == uid
        && eligibleRecipient(resource.data.roomId, uid, resource.data.createdAt);
      allow delete: if false;
      match /{nested=**} { allow read, write: if false; }
    }

    // Room-wide calendar projections remain closed until M3.2b.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
